---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { IconType } from "react-icons";
import { FaAws, FaJava } from "react-icons/fa";
import { SiSnowflake } from "react-icons/si";
import snowproCore from "../../assets/certifications/snowpro-core.png";
import awsCloudPractitioner from "../../assets/certifications/aws-cloud-practitioner.png";
import oracleJavaGold from "../../assets/certifications/oracle-java-gold-se11.png";
import oracleJavaSilver from "../../assets/certifications/oracle-java-silver-se11.png";

interface Certification {
    name: string;
    issuer: string;
    title: string;
    acquired: string;
    acquiredDate: string;
    url: string;
    badge?: ImageMetadata;
    Icon: IconType;
    iconClass: string;
}

const certifications: Certification[] = [
    {
        name: "Snowflake SnowPro Core Certification",
        issuer: "Snowflake",
        title: "SnowPro Core",
        acquired: "2026年10月取得",
        acquiredDate: "2026-10",
        url: "https://learn.snowflake.com/en/certifications/snowpro-core-c03/",
        badge: snowproCore,
        Icon: SiSnowflake,
        iconClass: "bg-sky-50 text-sky-600",
    },
    {
        name: "AWS Certified Cloud Practitioner",
        issuer: "AWS Certified",
        title: "Cloud Practitioner",
        acquired: "2025年4月取得",
        acquiredDate: "2025-04",
        url: "https://aws.amazon.com/certification/certified-cloud-practitioner/",
        badge: awsCloudPractitioner,
        Icon: FaAws,
        iconClass: "bg-violet-50 text-violet-700",
    },
    {
        name: "Oracle Certified Java Programmer, Gold SE 11",
        issuer: "Oracle Certified",
        title: "Java Gold SE 11",
        acquired: "2024年8月取得",
        acquiredDate: "2024-08",
        url: "https://www.credly.com/org/oracle/badge/oracle-certified-java-programmer-gold-se-11-oracle-certified-professional-java-se-11-programmer-jpn",
        badge: oracleJavaGold,
        Icon: FaJava,
        iconClass: "bg-amber-50 text-amber-700",
    },
    {
        name: "Oracle Certified Java Programmer, Silver SE 11",
        issuer: "Oracle Certified",
        title: "Java Silver SE 11",
        acquired: "2024年5月取得",
        acquiredDate: "2024-05",
        url: "https://www.credly.com/org/oracle/badge/oracle-certified-java-programmer-silver-se-11-jpn",
        badge: oracleJavaSilver,
        Icon: FaJava,
        iconClass: "bg-slate-100 text-slate-600",
    },
];
---

<ul role="list" class="divide-y divide-gray-200">
    {
        certifications.map(({ name, issuer, title, acquired, acquiredDate, url, badge, Icon, iconClass }) => (
            <li class="certification-item grid grid-cols-[4rem_minmax(0,1fr)] items-center gap-x-4 py-5 first:pt-0 last:pb-0 sm:grid-cols-[5rem_minmax(0,1fr)_auto] sm:gap-x-6">
                <span
                    aria-hidden="true"
                    class:list={[
                        "row-span-2 flex size-16 items-center justify-center sm:row-span-1 sm:size-20",
                        !badge && ["rounded-xl", iconClass],
                    ]}
                >
                    {badge ? (
                        <Image
                            src={badge}
                            alt=""
                            width={192}
                            height={192}
                            class="size-full object-contain"
                            loading="lazy"
                        />
                    ) : (
                        <Icon size={28} />
                    )}
                </span>
                <div class="min-w-0">
                    <p class="text-sm text-gray-600">{issuer}</p>
                    <h3>
                        <a
                            href={url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${issuer} ${title}の公式ページを開く（新しいタブ）`}
                            title={name}
                            class="certification-link inline-flex min-h-11 items-center gap-2 text-base font-semibold text-gray-800 underline decoration-gray-400 underline-offset-4 transition-colors hover:text-blue-600 hover:decoration-blue-600 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gray-600 sm:text-lg"
                        >
                            {title}
                            <svg
                                aria-hidden="true"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.75"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="size-4 shrink-0"
                            >
                                <path d="M7 17 17 7M7 7h10v10" />
                            </svg>
                        </a>
                    </h3>
                </div>
                <time datetime={acquiredDate} class="col-start-2 block whitespace-nowrap text-sm tabular-nums text-gray-600 sm:col-start-auto">{acquired}</time>
            </li>
        ))
    }
</ul>
